{
  "name": "director-narrative-core",
  "version": "0.1.0",
  "description": "N-API bindings for the iRacing narrative engine",
  "main": "index.js",
  "napi": {
    "binaryName": "index",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node smoke_test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ]
}
